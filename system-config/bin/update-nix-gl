#!/usr/bin/env bash
# Keep the NixOS-style /run/opengl-driver path and fontconfig config
# in sync with the current nix store, for systems where GL/fonts are
# provided by nixpkgs instead of the distro (Arch + nix setup).
set -euo pipefail

# Latest nixpkgs mesa (must contain the GBM driver niri needs)
mesa_dir=$(ls -d /nix/store/*-mesa-[0-9]*/ 2>/dev/null | sort -V | tail -1)
if [ -n "${mesa_dir:-}" ] && [ -f "${mesa_dir}lib/gbm/dri_gbm.so" ]; then
  ln -sfn "${mesa_dir%/}" /etc/opengl-driver
  systemd-tmpfiles --create /etc/tmpfiles.d/opengl-driver.conf || true
else
  echo "update-nix-gl: no suitable mesa found in /nix/store" >&2
fi

# Latest nixpkgs fontconfig config
fontconfig_conf=$(ls -d /nix/store/*-fontconfig-*/etc/fonts/fonts.conf 2>/dev/null | sort -V | tail -1)
if [ -n "${fontconfig_conf:-}" ]; then
  install -d /etc/environment.d
  printf 'FONTCONFIG_FILE=%s\n' "$fontconfig_conf" > /etc/environment.d/99-nix-gl.conf
else
  echo "update-nix-gl: no nixpkgs fontconfig found in /nix/store" >&2
fi
