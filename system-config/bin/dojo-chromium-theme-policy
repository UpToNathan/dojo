#!/usr/bin/env bash
set -euo pipefail

export PATH=/usr/bin:/bin

fail() {
    printf 'dojo-chromium-theme-policy: %s\n' "$1" >&2
    exit 1
}

[[ $EUID -eq 0 ]] || fail 'must be run as root'
[[ $# -eq 1 ]] || fail 'expected one #RRGGBB color or --clear'

color=${1,,}
[[ $color == --clear || $color =~ ^#[0-9a-f]{6}$ ]] || fail 'expected one #RRGGBB color or --clear'

for directory in /etc/chromium /etc/chromium/policies /etc/chromium/policies/managed; do
    if [[ -L $directory || ( -e $directory && ! -d $directory ) ]]; then
        fail "refusing unsafe policy directory $directory"
    fi
    if [[ ! -e $directory ]]; then
        /usr/bin/install -d -m 0755 -o root -g root -- "$directory"
    fi
    [[ $(/usr/bin/stat -c '%U:%G %a' -- "$directory") == 'root:root 755' ]] ||
        fail "policy directory must be root:root mode 0755: $directory"
done

policy_dir=/etc/chromium/policies/managed
policy_file=$policy_dir/dojo-theme.json

backup_dir=/etc/chromium/policies/dojo-backups
if [[ -L $backup_dir || ( -e $backup_dir && ! -d $backup_dir ) ]]; then
    fail "refusing unsafe backup directory $backup_dir"
fi
if [[ ! -e $backup_dir ]]; then
    /usr/bin/install -d -m 0755 -o root -g root -- "$backup_dir"
fi
[[ $(/usr/bin/stat -c '%U:%G %a' -- "$backup_dir") == 'root:root 755' ]] ||
    fail "backup directory must be root:root mode 0755: $backup_dir"

dojo_policy_pattern='^\{"BrowserThemeColor": "#[0-9a-f]{6}", "BrowserColorScheme": "system"\}$'
is_dojo_policy() {
    [[ -f $1 && ! -L $1 ]] &&
        [[ $(/usr/bin/stat -c '%U:%G %a' -- "$1") == 'root:root 644' ]] &&
        [[ $(/usr/bin/cat -- "$1") =~ $dojo_policy_pattern ]]
}

shopt -s nullglob dotglob
# Chromium reads every regular file in managed, regardless of its suffix.
for previous in "$policy_dir"/dojo-theme.json.backup-*; do
    [[ ${previous##*/} =~ ^dojo-theme\.json\.backup-[0-9]{14}-[0-9]+$ ]] || continue
    is_dojo_policy "$previous" || continue
    destination="$backup_dir/${previous##*/}"
    [[ ! -e $destination && ! -L $destination ]] || fail "backup already exists: $destination"
    /usr/bin/mv -T -- "$previous" "$destination"
done

if [[ -e $policy_file || -L $policy_file ]]; then
    is_dojo_policy "$policy_file" || fail "refusing to replace policy file not owned by Dojo: $policy_file"
fi

if [[ $color == --clear ]]; then
    if [[ -e $policy_file ]]; then
        destination="$backup_dir/dojo-theme.json.backup-$(/usr/bin/date +%Y%m%d%H%M%S)-$$"
        [[ ! -e $destination && ! -L $destination ]] || fail "backup already exists: $destination"
        /usr/bin/mv -T -- "$policy_file" "$destination"
    fi
    exit 0
fi

for other in "$policy_dir"/*; do
    [[ $other == "$policy_file" ]] && continue
    [[ -d $other && ! -L $other ]] && continue
    [[ -f $other && ! -L $other ]] || fail "refusing unsafe managed policy file $other"
    if /usr/bin/grep -Eq '"BrowserThemeColor"[[:space:]]*:|"BrowserColorScheme"[[:space:]]*:' "$other"; then
        fail "another managed policy already sets browser theme colors: $other"
    fi
done

temporary=$(/usr/bin/mktemp "$backup_dir/.dojo-theme.XXXXXX")
cleanup() {
    [[ -z ${temporary:-} ]] || /usr/bin/rm -f -- "$temporary"
}
trap cleanup EXIT

/usr/bin/printf '{"BrowserThemeColor": "%s", "BrowserColorScheme": "system"}\n' "$color" >"$temporary"
/usr/bin/chown root:root -- "$temporary"
/usr/bin/chmod 0644 -- "$temporary"
/usr/bin/mv -fT -- "$temporary" "$policy_file"
temporary=
