<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  What 1Password asks polkit to confirm: unlocking the app with the system's own authentication (a
  fingerprint or the login password, through /etc/pam.d/polkit-1) instead of the account password, and
  letting its command line and SSH agent reach the account. The app asks for these action ids; a Nix
  package cannot install this file under /usr/share, so system-config installs it. @USER@ is the
  account that runs the installer, the only one allowed to ask on behalf of others.
-->
<policyconfig>
  <action id="com.1password.1Password.unlock">
    <description>Unlock 1Password</description>
    <message>Authenticate to unlock 1Password</message>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
  <action id="com.1password.1Password.authorizeCLI">
    <description>Authorize CLI</description>
    <message>1Password CLI is trying to access your 1Password account.</message>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:@USER@</annotate>
  </action>
  <action id="com.1password.1Password.authorizeSshAgent">
    <description>Authorize SSH Agent</description>
    <message>1Password SSH Agent is trying to access your 1Password account.</message>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:@USER@</annotate>
  </action>
</policyconfig>
