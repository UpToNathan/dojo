// The login screen's Niri. Its only client is dojo-greeter; there are no key bindings, so nothing
// else can be started from the keyboard. @RELEASE@ becomes the installed release directory.
// dojo-dm watches this Niri, not the greeter: a greeter that ends before it ever connects (no
// socket, a crash at start-up) would otherwise leave a locked black screen until the connect
// timeout, and the three-failures-in-30-seconds limit would never be reached. So Niri leaves with it.
spawn-sh-at-startup ". @RELEASE@/environment.sh && @RELEASE@/dojo-greeter; @RELEASE@/niri msg action quit --skip-confirmation"

prefer-no-csd
screenshot-path null

hotkey-overlay {
    skip-at-startup
}

config-notification {
    disable-failed
}

xwayland-satellite {
    off
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 2000
}

input {
    touchpad {
        tap
    }
}

layout {
    background-color "#000000"
    gaps 0
    focus-ring {
        off
    }
    border {
        off
    }
}
