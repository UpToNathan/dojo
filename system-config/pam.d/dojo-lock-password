#%PAM-1.0
# /etc/pam.d/dojo-lock-password  -- password ONLY, shares the account's pam_faillock tally with dojo-login/sudo/login
# (same policy as /etc/pam.d/system-auth, minus nullok / systemd_home / pam_env which are irrelevant to a locker).
#
# Non-root notes (tested as uid 1000 with a private confdir):
#  * pam_unix works unprivileged via the setuid helper unix_chkpwd (it may only check the caller's own account).
#  * pam_faillock can read/append /run/faillock/<user> only if that file already exists (root creates it on the
#    first login/sudo and chowns it to the user; /run/faillock itself is root:root 755 so a non-root locker can
#    never create it).  A missing/unwritable tally degrades silently: wrong password -> still AUTH_ERR,
#    correct password -> still SUCCESS (verified), the failure just isn't counted.
#  * pam_faillock logs "Error sending audit message: Operation not permitted" when unprivileged; harmless.
#  * A locked account (3 failures / 15 min => 10 min lock, faillock.conf defaults) rejects even the CORRECT
#    password (authsucc returns PAM_AUTH_ERR) -- preauth also emits TEXT_INFO "The account is locked ..." that
#    the UI can show.  Fingerprint (separate service) still works while the password is locked.
auth     required                   pam_faillock.so preauth
auth     [success=1 default=bad]    pam_unix.so     try_first_pass
auth     [default=die]              pam_faillock.so authfail
auth     required                   pam_faillock.so authsucc
account  required                   pam_permit.so
# pam_unix failure adds a ~1.5-3 s delay inside pam_authenticate (libpam fail-delay); fine because it lives in a
# worker process.  To make it UI-controlled, set PAM_FAIL_DELAY via pam_set_item in the locker.
