+//! Throwaway spike: an in-process, headless, multi-output niri listening on a real socket.
+use std::time::{Duration, Instant};
+
+use calloop::EventLoop;
+use niri_config::Config;
+use smithay::reexports::wayland_server::Display;
+
+use crate::niri::State;
+
+#[test]
+#[ignore]
+fn lock_spike_two_outputs() {
+    let mut event_loop: EventLoop<'static, State> = EventLoop::try_new().unwrap();
+    let handle = event_loop.handle();
+    let display = Display::new().unwrap();
+    let mut state = State::new(
+        Config::default(),
+        handle.clone(),
+        event_loop.get_signal(),
+        display,
+        true,
+        true,
+        false,
+        false,
+    )
+    .unwrap();
+    state.backend.headless().add_renderer().unwrap();
+    {
+        let niri = &mut state.niri;
+        state.backend.headless().add_output(niri, 1, (1280, 720));
+        state.backend.headless().add_output(niri, 2, (800, 600));
+    }
+    let socket = state.niri.socket_name.clone().unwrap();
+    std::fs::write(
+        "/tmp/lock-spike-headless.env",
+        format!("export WAYLAND_DISPLAY={}\n", socket.to_string_lossy()),
+    )
+    .unwrap();
+    eprintln!("HEADLESS SOCKET {socket:?}");
+    let seconds: u64 = std::env::var("LOCK_SPIKE_SECONDS")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(120);
+    let deadline = Instant::now() + Duration::from_secs(seconds);
+    while Instant::now() < deadline {
+        event_loop
+            .dispatch(Duration::from_millis(16), &mut state)
+            .unwrap();
+        state.refresh_and_flush_clients();
+    }
+}
