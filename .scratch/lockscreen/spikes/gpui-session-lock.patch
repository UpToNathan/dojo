@@ -0,0 +1,287 @@
+//! Throwaway spike: lock the session through `ext-session-lock-v1` with one GPUI window per
+//! output, a clock and a password field. Type `test` and press Enter to unlock.
+#[cfg(all(target_os = "linux", feature = "wayland"))]
+mod example {
+    use std::{
+        ops::Range,
+        time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+    };
+
+    use gpui::{
+        App, Bounds, Context, ElementInputHandler, Entity, EntityInputHandler, FocusHandle,
+        Focusable, KeyBinding, SessionLockEvent, UTF16Selection, Window, WindowBounds,
+        WindowKind, WindowOptions, actions, canvas, div, point, prelude::*, px, rgb, size, white,
+    };
+    use gpui_platform::application;
+
+    actions!(session_lock, [Submit, Backspace]);
+
+    struct LockView {
+        focus_handle: FocusHandle,
+        password: String,
+        marked: Option<Range<usize>>,
+        message: &'static str,
+    }
+
+    impl LockView {
+        fn submit(&mut self, _: &Submit, _: &mut Window, cx: &mut Context<Self>) {
+            eprintln!("event=submit len={}", self.password.chars().count());
+            if self.password == "test" {
+                cx.unlock_session();
+                eprintln!("event=unlock-requested");
+                cx.quit();
+            } else {
+                self.password.clear();
+                self.message = "wrong password";
+                cx.notify();
+            }
+        }
+
+        fn backspace(&mut self, _: &Backspace, _: &mut Window, cx: &mut Context<Self>) {
+            self.password.pop();
+            cx.notify();
+        }
+    }
+
+    impl Focusable for LockView {
+        fn focus_handle(&self, _: &App) -> FocusHandle {
+            self.focus_handle.clone()
+        }
+    }
+
+    impl EntityInputHandler for LockView {
+        fn text_for_range(
+            &mut self,
+            _: Range<usize>,
+            _: &mut Option<Range<usize>>,
+            _: &mut Window,
+            _: &mut Context<Self>,
+        ) -> Option<String> {
+            None
+        }
+
+        fn selected_text_range(
+            &mut self,
+            _: bool,
+            _: &mut Window,
+            _: &mut Context<Self>,
+        ) -> Option<UTF16Selection> {
+            let end = self.password.encode_utf16().count();
+            Some(UTF16Selection {
+                range: end..end,
+                reversed: false,
+            })
+        }
+
+        fn marked_text_range(&self, _: &mut Window, _: &mut Context<Self>) -> Option<Range<usize>> {
+            self.marked.clone()
+        }
+
+        fn unmark_text(&mut self, _: &mut Window, _: &mut Context<Self>) {
+            self.marked = None;
+        }
+
+        fn replace_text_in_range(
+            &mut self,
+            _: Option<Range<usize>>,
+            text: &str,
+            window: &mut Window,
+            cx: &mut Context<Self>,
+        ) {
+            let viewport = window.viewport_size();
+            eprintln!(
+                "event=text-input text={text:?} window={}x{}",
+                f32::from(viewport.width),
+                f32::from(viewport.height)
+            );
+            if let Some(marked) = self.marked.take() {
+                self.password.truncate(marked.start);
+            }
+            self.password.push_str(text);
+            cx.notify();
+        }
+
+        fn replace_and_mark_text_in_range(
+            &mut self,
+            _: Option<Range<usize>>,
+            text: &str,
+            _: Option<Range<usize>>,
+            _: &mut Window,
+            cx: &mut Context<Self>,
+        ) {
+            eprintln!("event=ime-preedit text={text:?}");
+            let start = self
+                .marked
+                .take()
+                .map_or(self.password.len(), |marked| marked.start);
+            self.password.truncate(start);
+            self.password.push_str(text);
+            self.marked = Some(start..self.password.len());
+            cx.notify();
+        }
+
+        fn bounds_for_range(
+            &mut self,
+            _: Range<usize>,
+            bounds: Bounds<gpui::Pixels>,
+            _: &mut Window,
+            _: &mut Context<Self>,
+        ) -> Option<Bounds<gpui::Pixels>> {
+            Some(bounds)
+        }
+
+        fn character_index_for_point(
+            &mut self,
+            _: gpui::Point<gpui::Pixels>,
+            _: &mut Window,
+            _: &mut Context<Self>,
+        ) -> Option<usize> {
+            None
+        }
+    }
+
+    impl Render for LockView {
+        fn render(&mut self, window: &mut Window, cx: &mut Context<Self>) -> impl IntoElement {
+            let now = SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .map_or(0, |elapsed| elapsed.as_secs());
+            let clock = format!(
+                "{:02}:{:02}",
+                (now / 3600) % 24,
+                (now / 60) % 60
+            );
+            let dots = "\u{25cf}".repeat(self.password.chars().count());
+            let entity = cx.entity();
+            let focus_handle = self.focus_handle.clone();
+            let size = window.viewport_size();
+            div()
+                .key_context("LockView")
+                .track_focus(&self.focus_handle)
+                .on_action(cx.listener(Self::submit))
+                .on_action(cx.listener(Self::backspace))
+                .size_full()
+                .bg(rgb(0x101018))
+                .text_color(white())
+                .flex()
+                .flex_col()
+                .items_center()
+                .justify_center()
+                .gap_4()
+                .child(div().text_size(px(96.)).child(clock))
+                .child(
+                    div()
+                        .w(px(360.))
+                        .h(px(48.))
+                        .px_3()
+                        .flex()
+                        .items_center()
+                        .border_1()
+                        .border_color(rgb(0x7aa2f7))
+                        .rounded_md()
+                        .text_size(px(24.))
+                        .child(dots)
+                        .child(canvas(
+                            |_, _, _| {},
+                            move |bounds, (), window, cx| {
+                                window.handle_input(
+                                    &focus_handle,
+                                    ElementInputHandler::new(bounds, entity),
+                                    cx,
+                                );
+                            },
+                        )),
+                )
+                .child(div().text_size(px(16.)).child(format!(
+                    "{} ({}x{} px)",
+                    self.message,
+                    f32::from(size.width),
+                    f32::from(size.height)
+                )))
+        }
+    }
+
+    pub fn main() {
+        let started = Instant::now();
+        application().run(move |cx: &mut App| {
+            cx.bind_keys([
+                KeyBinding::new("enter", Submit, Some("LockView")),
+                KeyBinding::new("backspace", Backspace, Some("LockView")),
+            ]);
+            cx.on_session_lock_event(move |event, cx| {
+                eprintln!(
+                    "event={event:?} elapsed_ms={}",
+                    started.elapsed().as_millis()
+                );
+                if event == SessionLockEvent::Finished {
+                    cx.quit();
+                }
+            });
+            cx.observe_keystrokes(|event, _, _| {
+                eprintln!(
+                    "event=keystroke key={} key_char={:?}",
+                    event.keystroke.unparse(),
+                    event.keystroke.key_char
+                );
+            })
+            .detach();
+
+            let displays = cx.displays();
+            eprintln!("event=displays count={}", displays.len());
+            for display in displays {
+                let bounds = Bounds {
+                    origin: point(px(0.), px(0.)),
+                    size: size(px(800.), px(600.)),
+                };
+                eprintln!("event=open-window-start elapsed_ms={}", started.elapsed().as_millis());
+                let window = cx
+                    .open_window(
+                        WindowOptions {
+                            titlebar: None,
+                            window_bounds: Some(WindowBounds::Windowed(bounds)),
+                            display_id: Some(display.id()),
+                            app_id: Some("dojo-lock-spike".to_string()),
+                            kind: WindowKind::SessionLock,
+                            ..Default::default()
+                        },
+                        |window, cx| {
+                            let view = cx.new(|cx| LockView {
+                                focus_handle: cx.focus_handle(),
+                                password: String::new(),
+                                marked: None,
+                                message: "type 'test' and press Enter",
+                            });
+                            window.focus(&view.focus_handle(cx), cx);
+                            view
+                        },
+                    )
+                    .expect("open session lock window");
+                eprintln!("event=open-window-done elapsed_ms={}", started.elapsed().as_millis());
+                let view: Entity<LockView> = window
+                    .entity(cx)
+                    .expect("window root entity");
+                let view = view.downgrade();
+                cx.spawn(async move |cx| {
+                    loop {
+                        let seconds_into_minute = SystemTime::now()
+                            .duration_since(UNIX_EPOCH)
+                            .map_or(0, |elapsed| elapsed.as_secs() % 60);
+                        cx.background_executor()
+                            .timer(Duration::from_secs(60 - seconds_into_minute))
+                            .await;
+                        if view.update(cx, |_, cx| cx.notify()).is_err() {
+                            break;
+                        }
+                    }
+                })
+                .detach();
+            }
+        });
+    }
+}
+
+fn main() {
+    #[cfg(all(target_os = "linux", feature = "wayland"))]
+    example::main();
+    #[cfg(not(all(target_os = "linux", feature = "wayland")))]
+    panic!("This example requires the `wayland` feature and a linux system.");
+}
