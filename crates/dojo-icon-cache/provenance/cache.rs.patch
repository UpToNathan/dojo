+fn owned_cache_name(name: &str) -> bool {
+    let Some((stem, extension)) = name.rsplit_once('.') else {
+        return false;
+    };
+    if !matches!(extension, "png" | "svg" | "none") {
+        return false;
+    }
+    let stem = if extension == "png" {
+        stem.strip_suffix("@1x").unwrap_or(stem)
+    } else {
+        stem
+    };
+    stem.len() == 32 && stem.bytes().all(|byte| byte.is_ascii_hexdigit())
 }
 
