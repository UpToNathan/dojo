+struct InflightCleanup<'a> {
+    inflight: &'a Mutex<HashMap<IconKey, Pending>>,
+    owned: Vec<(IconKey, Pending)>,
+}
+impl Drop for InflightCleanup<'_> {
+    fn drop(&mut self) {
+        let mut inflight = self.inflight.lock().expect("inflight");
+        for (key, channel) in &self.owned {
+            if inflight
+                .get(key)
+                .is_some_and(|current| current.same_channel(channel))
+            {
+                inflight.remove(key);
+            }
+        }
+    }
 }
 
