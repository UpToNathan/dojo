  "divergences": [
    {
      "behavior": "Privacy filtering replaces upstream PII pass-through; bounded recording and in-memory image ingestion",
      "reason": "Secrets must be filtered before persistence; untrusted IDs are not filenames",
      "reconsideration": "Scope-aware capture policy and deterministic stronger filtering become available"
    },
    {
      "behavior": "Replay analysis never dispatches effects",
      "reason": "Missing receipts cannot prove that an effect did not happen",
      "reconsideration": "Explicit authorized fresh-state execution exists outside recording"
    },
    {
      "behavior": "Relative ATIF times in extra, null absolute timestamps",
      "reason": "No fabricated wall-clock dates",
      "reconsideration": "Caller supplies validated absolute acquisition times"
    },
    {
      "behavior": "Aguvis SplitMix64 deterministic Rust seed, explicit predefined-action spaces and restricted full grammar",
      "reason": "Stable Rust augmentation, avoid ambiguous pixels and executable syntax",
      "reconsideration": "Port MT19937 only if byte-parity datasets are required"
    },
    {
      "behavior": "No PIL font/image annotation or Arrow/Hugging Face IO",
      "reason": "Typed geometry and caller-supplied artifacts work without Python or optional dataset dependencies",
      "reconsideration": "Rust annotation/export adapter requested with licensed artifacts"
    },
    {
      "behavior": "Terminal CSI M/S rejected; parameter and work bounds before imported renderer",
      "reason": "Pinned full-region scroll-up arithmetic can underflow; large tab counts can hang",
      "reconsideration": "Upstream renderer fixes proven by matching adversarial fixtures"
    },
    {
      "behavior": "Typed integer usage receipts and microUSD known-cost coverage replace unrestricted nested callback addition",
      "reason": "Avoid overflow, duplicate canonical receipt counting, arbitrary metadata persistence and invented costs",
      "reconsideration": "Provider-specific adapters prove inclusive input/cache/cost conventions"
    }
  ],
