     #[test]
+    fn perception_lifetime_uses_registry_clock_without_renewal() {
+        let clock = Arc::new(ManualClock::default());
+        let service = CaptureService::with_clock(config(4, 10_000), clock.clone()).unwrap();
+        let owner = service.current_binding("owner").unwrap();
+        let id = service.publish(CapturePublication {
+            png_bytes: png(4, 3, 9), target: CaptureTarget::PrimaryDesktop,
+            encoded_dimensions: EncodedScreenshotDimensions::new(4, 3).unwrap(),
+            native_action_dimensions: NativeActionDimensions::new(4, 3).unwrap(),
+            screenshot_to_action: ScreenshotToActionTransform::identity(),
+            session_id: Arc::from("owner"), session_generation: owner.session_generation(),
+        }).unwrap();
+        let (first, remaining) = service.read_for_perception_with_lifetime(id, &owner).unwrap();
+        assert_eq!(remaining, Duration::from_secs(10));
+        clock.advance(Duration::from_secs(7));
+        let (second, remaining) = service.read_for_perception_with_lifetime(id, &owner).unwrap();
+        assert_eq!(remaining, Duration::from_secs(3));
+        assert!(Arc::ptr_eq(&first.png_bytes(), &second.png_bytes()));
+        clock.advance(Duration::from_secs(3));
+        assert_eq!(service.read_for_perception_with_lifetime(id, &owner).unwrap_err(), CaptureLookupError::Expired);
+        assert!(!first.png_bytes().is_empty());
+    }
