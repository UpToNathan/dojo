+    /// A bound read and its conservative remaining lifetime on the registry clock.
+    pub fn read_for_perception_with_lifetime(
+        &self,
+        id: CaptureId,
+        binding: &CaptureBinding,
+    ) -> Result<(PerceptionCapture, Duration), CaptureLookupError> {
+        let capture = self.registry.read_for_perception_bound(id, binding)?;
+        let remaining = capture.expires_at().saturating_sub(self.registry.clock.now());
+        if remaining.is_zero() {
+            return Err(CaptureLookupError::Expired);
+        }
+        Ok((capture, remaining))
+    }
