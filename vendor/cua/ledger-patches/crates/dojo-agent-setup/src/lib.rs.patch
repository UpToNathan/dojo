+    /// Returns the changes an apply would make without writing config, state,
+    /// backups, or skill files.
+    pub fn plan(
+        &self,
+        agents: &[String],
+        server: &McpServer,
+        force_skills: bool,
+    ) -> Result<Vec<Outcome>> {
+        if server.name != MCP_SERVER_NAME {
+            return Err(Error::InvalidArgument(format!(
+                "the Dojo server must be named {MCP_SERVER_NAME:?}"
+            )));
+        }
+        let specs = self.specs(agents)?;
+        let skills = skills::bundled();
+        let mut out = Vec::new();
+        for agent in specs {
+            if let Some(loc) = agent.skills {
+                for skill in &skills {
+                    let path = loc.resolve(&self.env).join(&skill.name);
+                    let current = fsutil::hash_dir(&path);
+                    let (change, detail) = match current.as_deref() {
+                        Some(hash) if hash == skill.hash => {
+                            (Change::Unchanged, format!("{} already current", skill.name))
+                        }
+                        Some(_) if !force_skills => (
+                            Change::Skipped,
+                            "existing or edited skill needs explicit force".into(),
+                        ),
+                        Some(_) => (
+                            Change::Updated,
+                            format!("would back up and update {}", skill.name),
+                        ),
+                        None => (Change::Created, format!("would install {}", skill.name)),
+                    };
+                    out.push(Outcome {
+                        agents: vec![agent.id.into()],
+                        target: Target::Skill,
+                        item: skill.name.clone(),
+                        path,
+                        change,
+                        detail,
+                        backup: None,
+                    });
+                }
+            } else {
+                out.push(Outcome {
+                    agents: vec![agent.id.into()],
+                    target: Target::Skill,
+                    item: DOJO_SKILL.into(),
+                    path: PathBuf::new(),
+                    change: Change::Skipped,
+                    detail: format!("{} does not support Agent Skills", agent.name),
+                    backup: None,
+                });
+            }
+            let Some(mcp) = agent.mcp else { continue };
+            let file = self.mcp_file(&mcp);
+            let mut outcome = Outcome {
+                agents: vec![agent.id.into()],
+                target: Target::Mcp,
+                item: server.name.clone(),
+                path: file.clone(),
+                change: Change::Created,
+                detail: "would register dojo-agent".into(),
+                backup: None,
+            };
+            let current = read_text(&file).and_then(|text| {
+                edit::validate(mcp.format, &file, &text)?;
+                edit::get(mcp.format, &file, &text, mcp.key_path, &server.name)
+            });
+            match current {
+                Ok(Some(value)) if value == edit::to_value(&mcp.shape.fields(server)) => {
+                    outcome.change = Change::Unchanged;
+                    outcome.detail = "already configured".into();
+                }
+                Ok(Some(_)) => {
+                    outcome.change = Change::Updated;
+                    outcome.detail = "would update Dojo entry".into();
+                }
+                Ok(None) => {}
+                Err(error) => {
+                    outcome.change = Change::Failed;
+                    outcome.detail = error.to_string();
+                }
+            }
+            out.push(outcome);
+        }
+        Ok(out)
+    }
