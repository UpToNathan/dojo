+fn png() -> Vec<u8> {
+    let image = image::RgbaImage::from_fn(4, 4, |x, y| {
+        image::Rgba(if x < 2 && y < 2 {
+            [255, 0, 0, 255]
+        } else {
+            [0, 0, 255, 255]
+        })
+    });
+    let mut png = Cursor::new(Vec::new());
+    image.write_to(&mut png, image::ImageFormat::Png).unwrap();
+    png.into_inner()
+}
