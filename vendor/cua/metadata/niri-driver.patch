+#[cfg(test)]
+mod niri_native_handler_tests {
+    use super::*;
+    use crate::wayland::niri::capture::tests::{inventory, logical, outputs, scene, WINDOW_ID};
+    use std::io::{BufRead, BufReader, Write};
+    use std::os::unix::net::UnixListener;
+    use std::sync::atomic::{AtomicBool, Ordering};
+
+    #[test]
+    fn original_handlers_deliver_exact_native_commands_from_one_use_captures() {
+        const CHILD: &str = "CUA_NIRI_NATIVE_HANDLER_CHILD";
+        if std::env::var_os(CHILD).is_none() {
+            let status = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", "tools::impl_::niri_native_handler_tests::original_handlers_deliver_exact_native_commands_from_one_use_captures"])
+                .env(CHILD, "1").env("PATH", "/nonexistent")
+                .env_remove("DISPLAY").env_remove("WAYLAND_DISPLAY")
+                .status().unwrap();
+            assert!(status.success());
+            return;
+        }
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("niri.sock");
+        let listener = UnixListener::bind(&path).unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let events = Arc::new(std::sync::Mutex::new(Vec::<Value>::new()));
+        let stop = Arc::new(AtomicBool::new(false));
+        let server_events = events.clone();
+        let server_stop = stop.clone();
+        let server = std::thread::spawn(move || {
+            let mut clients = Vec::new();
+            while !server_stop.load(Ordering::SeqCst) {
+                let (mut stream, _) = match listener.accept() {
+                    Ok(client) => client,
+                    Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                        std::thread::sleep(std::time::Duration::from_millis(1));
+                        continue;
+                    }
+                    Err(error) => panic!("{error}"),
+                };
+                let events = server_events.clone();
+                clients.push(std::thread::spawn(move || {
+                    stream.set_read_timeout(Some(std::time::Duration::from_secs(2))).unwrap();
+                    let mut reader = BufReader::new(stream.try_clone().unwrap());
+                    loop {
+                        let mut line = String::new();
+                        if reader.read_line(&mut line).unwrap() == 0 { break; }
+                        let request: Value = serde_json::from_str(&line).unwrap();
+                        let reply = if request == json!("Windows") { inventory() }
+                        else if request == json!("Workspaces") {
+                            json!({"Workspaces":[{"id":1,"idx":1,"name":null,"output":"DP-1","is_urgent":false,"is_active":true,"is_focused":true,"active_window_id":WINDOW_ID}]})
+                        } else if request == json!("Outputs") { outputs() }
+                        else if request == json!({"WindowPlacements":{"output":"DP-1"}}) {
+                            json!({"WindowPlacements":{"observation_serial":6,"compositor_pid":std::process::id(),"output":"DP-1","logical_output":logical(),"width":4,"height":4,"windows":scene()["CapturedScene"]["windows"].clone()}})
+                        } else if request == json!({"CaptureScene":{"output":"DP-1"}}) { scene() }
+                        else if request == json!("InputCoordination") {
+                            json!({"InputCoordination":{"revision":13,"human_owned_windows":[]}})
+                        } else if request == json!({"AgentInput":{"Create":{"name":"cua-driver"}}}) {
+                            json!({"AgentInputCreated":{"seat_name":"agent-fixture","peer_id":7}})
+                        } else {
+                            assert_eq!(request.pointer("/AgentInput/Coordinated/revision"),Some(&json!(13)));
+                            assert_eq!(request.pointer("/AgentInput/Coordinated/command/Captured/geometry/window_id"),Some(&json!(WINDOW_ID)));
+                            events.lock().unwrap().push(request["AgentInput"]["Coordinated"]["command"]["Captured"]["command"].clone());
+                            json!("Handled")
+                        };
+                        writeln!(stream,"{}",json!({"Ok":reply})).unwrap();
+                    }
+                }));
+            }
+            for client in clients {
+                client.join().unwrap();
+            }
+        });
+        std::env::set_var("NIRI_SOCKET", &path);
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap();
+        let state = ToolState::new();
+        runtime.block_on(async {
+            let cases: Vec<(Box<dyn Tool>,Value,Vec<Value>)> = vec![
+                (Box::new(ClickTool{state:state.clone()}),json!({"x":0.25,"y":0.25}),vec![
+                    json!({"Targeted":{"window_id":WINDOW_ID,"command":{"Move":{"output":"DP-1","x":0.25,"y":0.25}}}}),
+                    json!({"Targeted":{"window_id":WINDOW_ID,"command":{"Button":{"button":272,"state":"Pressed"}}}}),
+                    json!({"Targeted":{"window_id":WINDOW_ID,"command":{"Button":{"button":272,"state":"Released"}}}}),
+                ]),
+                (Box::new(PressKeyTool{state:state.clone()}),json!({"key":"enter"}),vec![
+                    json!({"Focus":{"window_id":WINDOW_ID}}),
+                    json!({"Targeted":{"window_id":WINDOW_ID,"command":{"Key":{"evdev":28,"state":"Pressed"}}}}),
+                    json!({"Targeted":{"window_id":WINDOW_ID,"command":{"Key":{"evdev":28,"state":"Released"}}}}),
+                ]),
+                (Box::new(TypeTextTool{state:state.clone()}),json!({"text":"a"}),vec![
+                    json!({"Focus":{"window_id":WINDOW_ID}}),
+                    json!({"Targeted":{"window_id":WINDOW_ID,"command":{"TextKey":{"evdev":30,"state":"Pressed"}}}}),
+                    json!({"Targeted":{"window_id":WINDOW_ID,"command":{"TextKey":{"evdev":30,"state":"Released"}}}}),
+                ]),
+                (Box::new(ScrollTool{state:state.clone()}),json!({"x":0.25,"y":0.25,"direction":"down","amount":2}),vec![
+                    json!({"Targeted":{"window_id":WINDOW_ID,"command":{"Move":{"output":"DP-1","x":0.25,"y":0.25}}}}),
+                    json!({"Targeted":{"window_id":WINDOW_ID,"command":{"Axis":{"horizontal":0.0,"vertical":30.0}}}}),
+                ]),
+                (Box::new(BringToFrontTool{state:state.clone()}),json!({}),vec![json!({"Focus":{"window_id":WINDOW_ID}})]),
+            ];
+            for (tool,mut args,expected) in cases {
+                let capture=GetWindowStateTool{state:state.clone()}.invoke(json!({
+                    "pid":std::process::id(),"window_id":WINDOW_ID,"include_accessibility_tree":false,"include_screenshot":true,
+                    "max_image_dimension":0,"full_output":true,"_session_id":"native-fixture"
+                })).await;
+                assert_ne!(capture.is_error,Some(true),"{:?}",capture.content);
+                let capture=capture.structured_content.unwrap()["capture_id"].as_str().unwrap().to_owned();
+                args["pid"]=json!(std::process::id());args["window_id"]=json!(WINDOW_ID);args["capture_id"]=json!(capture);args["_session_id"]=json!("native-fixture");
+                let before=events.lock().unwrap().len();
+                let result=tool.invoke(args.clone()).await;
+                assert_ne!(result.is_error,Some(true),"{}: {:?}",tool.def().name,result.content);
+                assert_eq!(&events.lock().unwrap()[before..],expected.as_slice(),"{} dispatched the wrong native operation",tool.def().name);
+                let reused=tool.invoke(args).await;
+                assert_eq!(reused.is_error,Some(true));
+                assert_eq!(events.lock().unwrap().len(),before+expected.len());
+            }
+            let capture=GetWindowStateTool{state:state.clone()}.invoke(json!({
+                "pid":std::process::id(),"window_id":WINDOW_ID,"include_accessibility_tree":false,"include_screenshot":true,
+                "max_image_dimension":0,"full_output":true,"_session_id":"native-fixture"
+            })).await;
+            assert_ne!(capture.is_error,Some(true));
+            let id=capture.structured_content.unwrap()["capture_id"].as_str().unwrap().to_owned();
+            let before=events.lock().unwrap().len();
+            let result=ClickTool{state:state.clone()}.invoke(json!({"pid":std::process::id(),"window_id":WINDOW_ID+1,"capture_id":id,"x":0,"y":0,"_session_id":"native-fixture"})).await;
+            assert_eq!(result.is_error,Some(true));assert_eq!(events.lock().unwrap().len(),before);
+            let binding=state.capture_service.current_binding("native-fixture").unwrap();
+            assert!(state.capture_service.read_for_perception(state.capture_service.parse_capture_id(&id).unwrap(),&binding).is_ok());
+        });
+        drop(state);
+        drop(runtime);
+        stop.store(true, Ordering::SeqCst);
+        server.join().unwrap();
+    }
+}
