+#[cfg(test)]
+mod niri_capture_handler_tests {
+    use super::*;
+    use crate::wayland::niri::capture::tests::{
+        fixture_groups, inventory, logical, outputs, scene, WINDOW_ID,
+    };
+
+    #[test]
+    fn original_window_handler_delivers_pixels_with_matching_scene_digest() {
+        const CHILD: &str = "CUA_NIRI_CAPTURE_HANDLER_CHILD";
+        if std::env::var_os(CHILD).is_none() {
+            let status = std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", "tools::impl_::niri_capture_handler_tests::original_window_handler_delivers_pixels_with_matching_scene_digest"])
+                .env(CHILD, "1").env("PATH", "/nonexistent")
+                .env_remove("DISPLAY").env_remove("WAYLAND_DISPLAY").status().unwrap();
+            assert!(status.success());
+            return;
+        }
+        let captured = scene();
+        let placements = json!({"WindowPlacements":{
+            "observation_serial":6,"compositor_pid":std::process::id(),"output":"DP-1",
+            "logical_output":logical(),"width":4,"height":4,"windows":captured["CapturedScene"]["windows"].clone()
+        }});
+        let workspaces = json!({"Workspaces":[{"id":1,"idx":1,"name":null,"output":"DP-1","is_urgent":false,
+            "is_active":true,"is_focused":true,"active_window_id":WINDOW_ID}]});
+        let (_directory, path, server) = fixture_groups(vec![
+            vec![
+                ("\"Windows\"", inventory()),
+                ("\"Workspaces\"", workspaces),
+                ("\"Outputs\"", outputs()),
+                ("{\"WindowPlacements\":{\"output\":\"DP-1\"}}", placements),
+            ],
+            vec![
+                ("\"Outputs\"", outputs()),
+                ("\"Windows\"", inventory()),
+                ("{\"CaptureScene\":{\"output\":\"DP-1\"}}", captured),
+            ],
+        ]);
+        std::env::set_var("NIRI_SOCKET", &path);
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap();
+        let result = runtime.block_on(GetWindowStateTool { state: ToolState::new() }.invoke(json!({
+            "pid":std::process::id(),"window_id":WINDOW_ID,"include_accessibility_tree":false,
+            "include_screenshot":true,"max_image_dimension":0,"full_output":true,"_observation_only":true,
+        })));
+        assert_ne!(
+            result.is_error,
+            Some(true),
+            "{:?}",
+            result.structured_content
+        );
+        let image = result
+            .content
+            .iter()
+            .find_map(|part| match part {
+                cua_driver_core::protocol::Content::Image { data, .. } => Some(data),
+                _ => None,
+            })
+            .unwrap();
+        use base64::{engine::general_purpose::STANDARD, Engine};
+        let png = STANDARD.decode(image).unwrap();
+        let image = image::load_from_memory(&png).unwrap().to_rgba8();
+        assert_eq!(image.dimensions(), (1, 1));
+        assert_eq!(image.get_pixel(0, 0).0, [255, 0, 0, 255]);
+        let structured = result.structured_content.unwrap();
+        assert_eq!(
+            structured["window_bounds"],
+            json!({"x":-8.0,"y":12.0,"width":1.0,"height":1.0})
+        );
+        assert_eq!(structured["niri_capture"]["scene_frame_serial"], 7);
+        assert_eq!(
+            structured["niri_capture"]["delivered_png_sha256"],
+            crate::wayland::niri::capture::hex_digest(&png)
+        );
+        assert_eq!(structured["niri_capture"]["image_geometry_atomic"], true);
+        assert_eq!(structured["niri_capture"]["image_semantic_atomic"], false);
+        server.join().unwrap();
+    }
+}
