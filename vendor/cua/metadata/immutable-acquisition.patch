+struct CatalogRegistry {
+    registry: FakeRegistry,
+    requests: Mutex<Vec<String>>,
+}
+
+#[async_trait::async_trait]
+impl ManifestSource for CatalogRegistry {
+    async fn manifest(&self, reference: &str) -> Result<(crate::manifest::Manifest, String)> {
+        self.requests.lock().unwrap().push(reference.into());
+        for entry in crate::catalog::entries() {
+            if let Some(digest) = &entry.digest
+                && NormalizedRef::parse(&entry.reference)?.pinned(digest) == reference
+            {
+                let (manifest, _) = self.registry.manifest(&entry.reference).await?;
+                return Ok((manifest, digest.clone()));
+            }
+        }
+        self.registry.manifest(reference).await
+    }
+    async fn blob(&self, reference: &str, desc: &crate::manifest::Descriptor) -> Result<Vec<u8>> {
+        self.registry.blob(reference, desc).await
+    }
+}
+
+#[tokio::test]
+async fn committed_catalog_digests_select_each_runtime_variant() {
+    let (registry, _, _) = canonical(false);
+    let source = CatalogRegistry {
+        registry,
+        requests: Mutex::new(Vec::new()),
+    };
+    let container = resolve_pinned_with(&source, LINUX, Backend::Container, "amd64")
+        .await
+        .unwrap();
+    assert_eq!(container.variant_ref, LINUX);
+    assert_eq!(
+        container.pinned_ref,
+        "ghcr.io/trycua/linux@sha256:ac5c9fd4aba25d5f1245a206191cfa6fc6ca7fceda60fcec1b7ec9d816223107"
+    );
+    let vm = resolve_pinned_with(&source, LINUX, Backend::Vm, "arm64")
+        .await
+        .unwrap();
+    assert_eq!(vm.variant_ref, LINUX_DISK);
+    assert_eq!(
+        vm.pinned_ref,
+        "ghcr.io/trycua/linux@sha256:c492b2d5b4b80a706f7a85e2333b6b57ad922282756f72f2cbde0c0809a38a8c"
+    );
+    assert_eq!(vm.os, "linux");
+    assert_eq!(vm.arch.as_deref(), Some("arm64"));
+    assert!(
+        source
+            .requests
+            .lock()
+            .unwrap()
+            .iter()
+            .all(|reference| reference.contains("@sha256:"))
+    );
+}
+
+#[tokio::test]
+async fn custom_mutable_image_is_refused_before_reading_registry() {
+    let source = CatalogRegistry {
+        registry: FakeRegistry::default(),
+        requests: Mutex::new(Vec::new()),
+    };
+    let error = resolve_pinned_with(
+        &source,
+        "ghcr.io/example/custom:latest",
+        Backend::Container,
+        "amd64",
+    )
+    .await
+    .unwrap_err();
+    assert!(matches!(error, ImageError::Reference(_, _)));
+    assert!(source.requests.lock().unwrap().is_empty());
+}
+
+#[tokio::test]
+async fn explicit_custom_digest_is_preserved() {
+    let mut source = FakeRegistry::default();
+    let digest = source.index("ghcr.io/example/custom:build", &["amd64"], false, None);
+    let reference = format!("ghcr.io/example/custom@{digest}");
+    let resolved = resolve_pinned_with(&source, &reference, Backend::Container, "amd64")
+        .await
+        .unwrap();
+    assert_eq!(resolved.pinned_ref, reference);
+}
+
+#[test]
+fn catalog_acquisition_refuses_missing_or_invalid_content_identity() {
+    assert!(acquisition_reference("ghcr.io/trycua/macos:26-xcode").is_err());
+    assert!(acquisition_reference("ghcr.io/example/custom@sha256:abc").is_err());
+}
