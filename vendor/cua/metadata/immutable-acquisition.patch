+fn acquisition_reference(reference: &str) -> Result<String> {
+    let normalized = NormalizedRef::parse(reference)?;
+    let digest = normalized.digest.as_deref().or_else(|| {
+        crate::catalog::find(&normalized.full()).and_then(|entry| entry.digest.as_deref())
+    }).ok_or_else(|| ImageError::Reference(reference.into(),
+        "Dojo requires a catalog image with a committed digest or an explicit @sha256 digest".into()))?;
+    if !digest
+        .strip_prefix("sha256:")
+        .is_some_and(|hex| hex.len() == 64 && hex.bytes().all(|b| b.is_ascii_hexdigit()))
+    {
+        return Err(ImageError::Reference(
+            reference.into(),
+            "expected @sha256 followed by 64 hex digits".into(),
+        ));
+    }
+    Ok(normalized.pinned(digest))
+}
