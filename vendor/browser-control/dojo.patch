 await ref("e12").click()
 await page.getByRole("heading", { name: "Settings" }).waitFor()
-if (!page.url().includes("/settings")) {
-  throw new Error(`Unexpected destination: ${page.url()}`)
-}
-return { url: page.url(), heading: await page.getByRole("heading").first().innerText() }
