{
  "manifest_version": 3,
  "name": "Dojo Tabs",
  "version": "1.0.0",
  "description": "Tells Dojo which tabs each browser window holds, so a whole window can be sent to another machine. It changes nothing in the browser.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["tabs", "nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "incognito": "not_allowed"
}
