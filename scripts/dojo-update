#!/usr/bin/env python3
"""Update Dojo software through its owning package managers."""

import argparse
import contextlib
import datetime as dt
import fcntl
import os
from pathlib import Path
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile

from arch_packages import archive_config, omarchy_stable_config


GROUPS = ("arch", "nix", "npm", "cargo", "mise", "codex", "claude", "t3code", "nvim", "inventory", "dojo")
DEFAULT_GROUPS = GROUPS[:-1]


def nonnegative(value):
    number = int(value)
    if number < 0 or number > 36500:
        raise argparse.ArgumentTypeError("must be between 0 and 36500")
    return number


def update_notice(results):
    """The notification for a finished run: (summary, body, urgency, icon)."""
    problems = [f"{name} {status}" for name, status, _ in results if status in ("failed", "blocked")]
    if problems:
        return ("Software update finished with problems", ", ".join(problems), "normal", "software-update-urgent-symbolic")
    done = sum(1 for _, status, _ in results if status == "ok")
    body = f"{done} {'step' if done == 1 else 'steps'} finished"
    return ("Software updated", body, "low", "software-update-available-symbolic")


def notify_binary():
    found = shutil.which("dojo-notify")
    if found:
        return found
    local = Path.home() / ".local/bin/dojo-notify"
    return str(local) if local.exists() else None


def send_notice(results):
    """Tells the person the run is over. A missing or failing dojo-notify is ignored."""
    try:
        binary = notify_binary()
        if not binary:
            return
        summary, body, urgency, icon = update_notice(results)
        subprocess.run([binary, "send", "--kind", "update", "--urgency", urgency, "--icon", icon, "--body", body, summary],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10, check=False)
    except Exception:
        pass


class Runner:
    def __init__(self, repo, dry_run):
        self.repo = repo
        self.dry_run = dry_run
        self.results = []

    def report(self, name, status, detail=""):
        self.results.append((name, status, detail))
        print(f"{name}: {status}" + (f" ({detail})" if detail else ""), flush=True)

    def command(self, name, argv, dependency=True):
        if not dependency:
            self.report(name, "blocked", "an earlier required step failed")
            return False
        if not shutil.which(argv[0]):
            self.report(name, "skipped", f"{argv[0]} is not installed")
            return False
        print(f"\n[{name}] {shlex.join(map(str, argv))}", flush=True)
        if self.dry_run:
            self.report(name, "planned")
            return True
        result = subprocess.run(argv, cwd=self.repo, check=False)
        self.report(name, "ok" if result.returncode == 0 else "failed", f"exit {result.returncode}")
        return result.returncode == 0


def update_arch(runner, days, now, source="archive"):
    if not shutil.which("pacman"):
        runner.report("arch", "skipped", "pacman is not installed")
        return
    if days == 0:
        runner.command("arch", ["sudo", "pacman", "-Syu"])
        return
    if source == "omarchy-stable":
        # Omarchy's delay is its own, not --buffer-days.
        label = "<omarchy-stable>"
        config = omarchy_stable_config(Path("/etc/pacman.conf").read_text())
    else:
        # Use the previous UTC day's snapshot to guarantee at least N full days.
        date = (now - dt.timedelta(days=days + 1)).strftime("%Y/%m/%d")
        label = f"<snapshot-{date}>"
        config = archive_config(Path("/etc/pacman.conf").read_text(), date)
    if runner.dry_run:
        runner.command("arch", ["sudo", "pacman", "--config", label, "-Syyu"])
        return
    with tempfile.NamedTemporaryFile(mode="w", prefix="dojo-pacman-", suffix=".conf") as stream:
        stream.write(config)
        stream.flush()
        runner.command("arch", ["sudo", "pacman", "--config", stream.name, "-Syyu"])


def update_group(group, runner, args, now):
    days = args.buffer_days
    cutoff = (now - dt.timedelta(days=days)).isoformat()
    if group == "arch":
        update_arch(runner, days, now, args.arch_source)
    elif group == "nix":
        ready = True
        if not args.keep_pins:
            ready = runner.command("nix-inputs", [sys.executable, str(runner.repo / "scripts/refresh-update-inputs.py"),
                                                  "--repo", str(runner.repo), "--buffer-days", str(days)])
        ready = runner.command("nix-lock", ["devenv", "update"], ready)
        runner.command("nix-home", ["devenv", "machines", "deploy", socket.gethostname()], ready)
    elif group == "npm":
        # home-manager.nix sets NPM_CONFIG_PREFIX for desktop sessions, not for ssh logins. Without it
        # npm targets the read-only Nix store.
        prefix = Path(os.environ.get("NPM_CONFIG_PREFIX") or Path.home() / ".local/npm")
        if not shutil.which("npm"):
            runner.report("npm", "skipped", "npm is not installed")
        elif not prefix.is_dir():
            runner.report("npm", "skipped", f"no global packages installed under {prefix}")
        else:
            runner.command("npm", ["env", f"NPM_CONFIG_PREFIX={prefix}", "npm", "update", "--global",
                                   f"--before={cutoff}"])
    elif group == "cargo":
        runner.command("cargo", [sys.executable, str(runner.repo / "scripts/update-cargo-tools.py"),
                                 "--buffer-days", str(days)])
    elif group == "mise":
        runner.command("mise", ["mise", "upgrade", "--minimum-release-age", f"{days}d", "--no-prune"])
        runner.report("mise-self", "manual", "packslip owns mise; its installer has no release-age filter")
    elif group == "t3code":
        # Installs the app where it is missing and follows its channel where it is not.
        runner.command(group, [sys.executable, str(runner.repo / "scripts/install-t3code.py")])
    elif group in ("codex", "claude"):
        runner.command(group, [group, "update"])
    elif group == "nvim":
        if days:
            runner.report("nvim", "held", "Lazy has no release-age filter; use --buffer-days 0 --only nvim")
        else:
            runner.command("nvim", ["nvim", "--headless", "+Lazy! update", "+qa"])
    elif group == "dojo":
        ready = runner.command("dojo-build", ["devenv", "shell", "--", "cargo", "build", "--release", "--bin", "dojo"])
        runner.command("dojo-install", ["devenv", "shell", "--", "scripts/install-dojo-release.sh"], ready)
    elif group == "inventory":
        runner.command("inventory-packages", [sys.executable, str(runner.repo / "scripts/capture-system-packages.py")])
        runner.command("inventory-config", [sys.executable, str(runner.repo / "scripts/capture-privileged-config.py")])


@contextlib.contextmanager
def update_lock(dry_run):
    if dry_run:
        yield
        return
    state = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
    if not state.is_absolute():
        raise ValueError("XDG_STATE_HOME must be absolute")
    directory = state / "dojo-update"
    directory.mkdir(parents=True, exist_ok=True)
    with (directory / "update.lock").open("a") as stream:
        try:
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError("another dojo-update is running") from None
        yield


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="print commands without running them, writing files, or fetching versions")
    parser.add_argument("--list", action="store_true", help="list update groups")
    parser.add_argument("--only", help="comma-separated groups to run")
    parser.add_argument("--skip", default="", help="comma-separated groups to skip")
    parser.add_argument("--buffer-days", type=nonnegative, default=3, help="minimum version age in days (default: 3); pi/opencode/codex/claude/t3code are exempt")
    parser.add_argument("--arch-source", choices=("archive", "omarchy-stable"), default="archive",
                        help="snapshot for buffered Arch updates: an Arch Linux Archive snapshot at least "
                             "--buffer-days old (default), or Omarchy's faster, unsigned stable mirror")
    parser.add_argument("--keep-pins", action="store_true", help="use existing devenv.yaml input revisions")
    args = parser.parse_args(argv)
    if args.list:
        print("\n".join(GROUPS))
        return 0
    selected = args.only.split(",") if args.only else list(DEFAULT_GROUPS)
    skipped = args.skip.split(",") if args.skip else []
    unknown = (set(selected) | set(skipped)) - set(GROUPS)
    if unknown:
        parser.error("unknown groups: " + ", ".join(sorted(unknown)))
    repo = Path(__file__).resolve().parent.parent
    runner = Runner(repo, args.dry_run)
    now = dt.datetime.now(dt.timezone.utc)
    print(f"Version buffer: {args.buffer_days} days. Exceptions: pi, opencode, codex, claude, t3code.", flush=True)
    try:
        with update_lock(args.dry_run):
            for group in GROUPS:
                if group not in selected or group in skipped:
                    continue
                try:
                    update_group(group, runner, args, now)
                except (OSError, ValueError) as error:
                    runner.report(group, "failed", str(error))
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\nUpdate interrupted.", file=sys.stderr)
        return 130
    print("\nUpdate summary", flush=True)
    for name, status, detail in runner.results:
        print(f"  {name}: {status}" + (f" ({detail})" if detail else ""))
    print("Manual sources: Helium/Rift/custom source hashes, 1Password CLI, AUR, other standalone tools and vendored Niri.")
    print("Dojo desktop build/install is opt-in: dojo-update --only dojo.")
    if not args.dry_run:
        send_notice(runner.results)
    return int(any(status in ("failed", "blocked") for _, status, _ in runner.results))


if __name__ == "__main__":
    sys.exit(main())
