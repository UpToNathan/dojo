#!/usr/bin/env bash
# Lets `loginctl lock-session` lock Dojo and holds a logind sleep delay
# inhibitor until the session is locked, so suspend never completes with the
# desktop visible. Neither stasis nor Niri does either: stasis only reads
# PrepareForSleep and LockedHint, and treats login1 Lock as a request it ignores.
#
# The inhibitor is held while idle and dropped once the session is locked after
# PrepareForSleep(true): the locker's `locked-at` marker is newer than the wait,
# or logind's LockedHint is true, whichever comes first. Niri sets no LockedHint
# here (its environment has no XDG_SESSION_ID), so the locker writes the marker
# and sets the hint itself. logind stops waiting after InhibitDelayMaxSec (5 s by
# default), so a locker that never takes the lock delays suspend, not blocks it.
set -euo pipefail

lock_now=${DOJO_LOCK_NOW:-"$(dirname -- "${BASH_SOURCE[0]}")/dojo-lock-now"}
hint_polls=${DOJO_LOCK_HINT_POLLS:-40}
marker=${DOJO_LOCK_MARKER:-"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dojo/locked-at"}

session_id=$(loginctl show-user "$(id -u)" --property=Display --value)
[[ -n $session_id ]] || { echo "dojo-lock-session-bridge: no graphical logind session" >&2; exit 1; }
session_path=$(busctl --system call org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager GetSession s "$session_id" | sed -n 's/^o "\(.*\)"$/\1/p')
[[ -n $session_path ]] || { echo "dojo-lock-session-bridge: logind has no session $session_id" >&2; exit 1; }

holder=
take_inhibitor() {
    [[ -z $holder ]] || return 0
    setsid systemd-inhibit --what=sleep --mode=delay --who=Dojo \
        --why="Lock the session before suspend" sleep infinity &
    holder=$!
}
drop_inhibitor() {
    [[ -n $holder ]] || return 0
    kill -- "-$holder" 2>/dev/null || true
    wait "$holder" 2>/dev/null || true
    holder=
}
# `began` is stamped before the lock is requested, so a marker written however
# quickly afterwards still counts as newer.
wait_for_lock() {
    local poll began=$1
    for ((poll = 0; poll < hint_polls; poll++)); do
        if [[ $marker -nt $began ]] ||
            [[ $(loginctl show-session "$session_id" --property=LockedHint --value) == yes ]]; then
            rm -f -- "$began"
            return 0
        fi
        sleep 0.1
    done
    rm -f -- "$began"
    echo "dojo-lock-session-bridge: session still unlocked after $hint_polls polls; releasing sleep" >&2
}
trap drop_inhibitor EXIT

exec {events}< <(exec gdbus monitor --system --dest org.freedesktop.login1)
take_inhibitor
while IFS= read -r line <&"$events"; do
    case $line in
        *"org.freedesktop.login1.Manager.PrepareForSleep (true,)"*)
            began=$(mktemp)
            "$lock_now" || true
            wait_for_lock "$began"
            drop_inhibitor
            ;;
        *"org.freedesktop.login1.Manager.PrepareForSleep (false,)"*)
            take_inhibitor
            ;;
        "$session_path: org.freedesktop.login1.Session.Lock ()")
            "$lock_now" || true
            ;;
    esac
done
echo "dojo-lock-session-bridge: logind monitor ended" >&2
exit 1
