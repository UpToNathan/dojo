#!/usr/bin/env bash
set -euo pipefail

script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
repo_root=$(cd -- "$(dirname -- "$script_path")/.." && pwd)
data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
if [[ $data_home != /* ]]; then
    printf 'XDG_DATA_HOME must be absolute.\n' >&2
    exit 1
fi
environment_file="$data_home/dojo/niri/current/environment.sh"
if [[ -f $environment_file ]]; then
    source "$environment_file"
fi
if [[ ${DOJO_SEMANTIC_AGENT_EXE+x} ]]; then
    executable=$(readlink -e -- "$DOJO_SEMANTIC_AGENT_EXE" || true)
    direct_agent=false
    if [[ $(dirname -- "$executable") == /nix/store && $(basename -- "$executable") == *-dojo-agent ]]; then
        direct_agent=true
    fi
    if [[ ( $executable != /nix/store/*/bin/dojo-agent && $direct_agent != true ) || ! -f $executable || ! -x $executable ]]; then
        printf 'DOJO_SEMANTIC_AGENT_EXE must pin an installed Nix-store dojo-agent.\n' >&2
        exit 1
    fi
    owner=$(stat -Lc '%u' -- "$executable")
    mode=$(stat -Lc '%a' -- "$executable")
    if [[ $owner != 0 ]] || (( (8#$mode & 8#222) != 0 )); then
        printf 'The pinned dojo-agent must be root-owned and immutable.\n' >&2
        exit 1
    fi
    if [[ $(od -An -tx1 -N4 -- "$executable" | tr -d ' \n') != 7f454c46 ]]; then
        printf 'DOJO_SEMANTIC_AGENT_EXE must pin a native ELF executable.\n' >&2
        exit 1
    fi
    exec "$executable" "$@"
fi
executable="$repo_root/target/debug/dojo-agent"
if [[ ! -x $executable ]]; then
    printf 'No pinned agent or development binary exists. Build dojo-agent inside devenv.\n' >&2
    exit 1
fi
exec "$executable" "$@"
