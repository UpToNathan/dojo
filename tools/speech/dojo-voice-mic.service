[Unit]
Description=Turn Dojo voice input on while a microphone is available
PartOf=graphical-session.target
# After the runtime, so it is up to be told; the runtime also checks once itself when it starts.
After=graphical-session.target pipewire-pulse.service dojo-voice.service
Wants=dojo-voice.service

[Service]
Type=simple
ExecStart=@DOJO_ROOT@/tools/speech/dojo-mic-watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
