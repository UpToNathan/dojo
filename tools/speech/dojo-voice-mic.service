[Unit]
Description=Run Dojo voice only while a microphone is available
PartOf=graphical-session.target
After=graphical-session.target pipewire-pulse.service

[Service]
Type=simple
ExecStart=@DOJO_ROOT@/tools/speech/dojo-mic-watch
ExecStopPost=-/usr/bin/systemctl --user stop --no-block dojo-voice.service
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
