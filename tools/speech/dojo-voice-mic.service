[Unit]
Description=Turn Dojo voice input on while a microphone is available
PartOf=graphical-session.target
# It does not start the runtime: `dojo-voice voice-input` does nothing while the runtime is idle, and
# the runtime checks for a microphone itself each time it starts.
After=graphical-session.target pipewire-pulse.service

[Service]
Type=simple
ExecStart=@DOJO_ROOT@/tools/speech/dojo-mic-watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
