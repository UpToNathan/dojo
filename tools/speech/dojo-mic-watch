#!/usr/bin/env bash
# Keeps dojo-voice.service running exactly while a microphone is available, so a machine
# without one holds no transcription model in memory. Runs as dojo-voice-mic.service.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
unit=dojo-voice.service

reconcile() {
    if "$here/dojo-mic-present"; then
        systemctl --user is-active --quiet "$unit" || systemctl --user start --no-block "$unit"
    else
        ! systemctl --user is-active --quiet "$unit" || systemctl --user stop --no-block "$unit"
    fi
}

reconcile
# Plugging a headset produces a burst of events; reconcile once the burst has settled.
dirty=0
while true; do
    status=0
    read -r -t 0.5 _ || status=$?
    if (( status == 0 )); then dirty=1
    elif (( status > 128 )); then
        if (( dirty )); then reconcile; dirty=0; fi
    else break
    fi
done < <(pactl subscribe | grep --line-buffered -E "on (source|card|server)")
# pactl subscribe ended (PipeWire restarted); systemd restarts this watcher.
exit 1
