#!/usr/bin/env bash
# Tells the agent runtime (dojo-voice.service, which runs on every host) whether voice input
# can run, so a machine without a microphone holds no transcription model in memory. Only the
# speech worker follows the microphone; the runtime keeps running. Runs as dojo-voice-mic.service.
# `dojo-voice voice-input` does nothing when the runtime is not running: the runtime checks for
# a microphone itself when it starts.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

reconcile() {
    local state=off
    if "$here/dojo-mic-present"; then state=on; fi
    # A runtime that is restarting or still old must not stop the watcher; the next event retries.
    "$here/dojo-voice" voice-input "$state" >/dev/null || printf 'dojo-voice voice-input %s failed\n' "$state" >&2
}

reconcile
# Plugging a headset produces a burst of events; reconcile once the burst has settled.
dirty=0
while true; do
    status=0
    read -r -t 0.5 _ || status=$?
    if (( status == 0 )); then dirty=1
    elif (( status > 128 )); then
        if (( dirty )); then reconcile; dirty=0; fi
    else break
    fi
done < <(pactl subscribe | grep --line-buffered -E "on (source|card|server)")
# pactl subscribe ended (PipeWire restarted); systemd restarts this watcher.
exit 1
