[Unit]
Description=Dojo agent runtime
# Started by dojo-voice.socket on the first connection, with or without a microphone. It exits after
# ten idle minutes and is started again by the next connection. Voice input is a part of it that
# dojo-voice-mic.service turns on and off as microphones come and go.
Requires=dojo-voice.socket
After=dojo-voice.socket

[Service]
Type=simple
WorkingDirectory=@DOJO_ROOT@
# Idle means no run, recording or request in progress; see VoiceService.scheduleDeadline.
Environment=DOJO_VOICE_IDLE_SECONDS=600
# The wrapper loads the installed environment itself, so there is no devenv shell to evaluate first.
ExecStart=@DOJO_ROOT@/tools/speech/dojo-voice --serve
Restart=on-failure
RestartSec=3
