[Unit]
Description=Dojo agent runtime and its command socket
# The agent runtime runs on every host, with or without a microphone. Voice input is a part of it
# that dojo-voice-mic.service turns on and off as microphones come and go.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=@DOJO_ROOT@
# The wrapper loads the installed environment itself, so there is no devenv shell to evaluate first.
ExecStart=@DOJO_ROOT@/tools/speech/dojo-voice --serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
