+gboolean
+dojo_atk_bridge_dup_accessible_reference (AtkObject *obj, gchar **owner, gchar **path)
+{
+  DBusMessage *message;
+  DBusMessageIter iter, fields;
+  AtkStateSet *states;
+  const char *bus_name = NULL, *object_path = NULL;
+  gboolean result = FALSE;
+
+  if (!owner || !path)
+    return FALSE;
+  *owner = NULL;
+  *path = NULL;
+  if (!inited || dojo_bridge_thread != g_thread_self () || !ATK_IS_OBJECT (obj) ||
+      !spi_global_app_data || !spi_global_app_data->bus ||
+      !spi_global_register || !spi_global_leasing ||
+      !dbus_connection_get_is_connected (spi_global_app_data->bus))
+    return FALSE;
+
+  states = atk_object_ref_state_set (obj);
+  if (!states)
+    return FALSE;
+  gboolean defunct = atk_state_set_contains_state (states, ATK_STATE_DEFUNCT);
+  g_object_unref (states);
+  if (defunct)
+    return FALSE;
+
+  message = dbus_message_new (DBUS_MESSAGE_TYPE_METHOD_RETURN);
+  if (!message)
+    return FALSE;
+  dbus_message_iter_init_append (message, &iter);
+  spi_object_append_reference (&iter, obj);
+  if (!dbus_message_iter_init (message, &iter) ||
+      dbus_message_iter_get_arg_type (&iter) != DBUS_TYPE_STRUCT)
+    goto out;
+  dbus_message_iter_recurse (&iter, &fields);
+  if (dbus_message_iter_get_arg_type (&fields) != DBUS_TYPE_STRING)
+    goto out;
+  dbus_message_iter_get_basic (&fields, &bus_name);
+  if (!dbus_message_iter_next (&fields) ||
+      dbus_message_iter_get_arg_type (&fields) != DBUS_TYPE_OBJECT_PATH)
+    goto out;
+  dbus_message_iter_get_basic (&fields, &object_path);
+  if (dbus_message_iter_next (&fields) || dbus_message_iter_next (&iter) ||
+      !bus_name || bus_name[0] != ':' || !dbus_validate_bus_name (bus_name, NULL) ||
+      !object_path || !dbus_validate_path (object_path, NULL) ||
+      !g_str_has_prefix (object_path, "/org/a11y/atspi/accessible/") ||
+      !strcmp (object_path, "/org/a11y/atspi/null"))
+    goto out;
+  *owner = g_strdup (bus_name);
+  *path = g_strdup (object_path);
+  result = TRUE;
+out:
+  dbus_message_unref (message);
+  return result;
+}
