+bool WaylandWindow::SetAccessibilityEndpoint(
+    std::optional<AccessibilityEndpoint> endpoint) {
+  CHECK(ui_task_runner_->BelongsToCurrentThread());
+  if (endpoint == accessibility_endpoint_ &&
+      (!endpoint || accessibility_annotation_)) {
+    return false;
+  }
+  const bool had_annotation = !!accessibility_annotation_;
+  accessibility_annotation_.reset();
+  accessibility_endpoint_.reset();
+  auto* manager = connection_->xdg_dbus_annotation_manager();
+  if (!endpoint || !manager || !root_surface_ || shutting_down_) {
+    if (had_annotation)
+      connection_->Flush();
+    return had_annotation;
+  }
+  accessibility_annotation_ = manager->Create(root_surface_->surface(), *endpoint);
+  if (!accessibility_annotation_)
+    return had_annotation;
+  accessibility_endpoint_ = std::move(endpoint);
+  return true;
+}
