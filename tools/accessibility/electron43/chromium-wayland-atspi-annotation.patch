--- /dev/null
+++ b/ui/ozone/platform/wayland/host/xdg_dbus_annotation.cc
@@ -0,0 +1,46 @@
+// Copyright 2025 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/ozone/platform/wayland/host/xdg_dbus_annotation.h"
+#include <xdg-dbus-annotation-v1-client-protocol.h>
+#include "base/logging.h"
+#include "ui/ozone/platform/wayland/host/wayland_connection.h"
+
+namespace ui {
+constexpr char XdgDBusAnnotationManager::kInterfaceName[];
+void XdgDBusAnnotationManager::Instantiate(WaylandConnection* connection,
+                                           wl_registry* registry,
+                                           uint32_t name,
+                                           const std::string& interface,
+                                           uint32_t version) {
+  CHECK_EQ(interface, kInterfaceName);
+  if (connection->xdg_dbus_annotation_manager_ ||
+      !wl::CanBind(interface, version, 1, 1))
+    return;
+  auto manager = wl::Bind<xdg_dbus_annotation_manager_v1>(registry, name, 1);
+  if (!manager)
+    return;
+  connection->xdg_dbus_annotation_manager_ =
+      std::make_unique<XdgDBusAnnotationManager>(manager.release());
+}
+XdgDBusAnnotationManager::XdgDBusAnnotationManager(
+    xdg_dbus_annotation_manager_v1* manager)
+    : manager_(manager) {}
+XdgDBusAnnotationManager::~XdgDBusAnnotationManager() = default;
+wl::Object<xdg_dbus_annotation_v1> XdgDBusAnnotationManager::Create(
+    wl_surface* surface,
+    const PlatformWindow::AccessibilityEndpoint& endpoint) {
+  wl::Object<xdg_dbus_annotation_v1> annotation(
+      xdg_dbus_annotation_manager_v1_annotate_surface(
+          manager_.get(), "org.a11y.atspi.Accessible", surface));
+  if (!annotation)
+    return annotation;
+  xdg_dbus_annotation_v1_set_bus(annotation.get(),
+                                 XDG_DBUS_ANNOTATION_V1_BUS_ENUM_ATSPI);
+  xdg_dbus_annotation_v1_set_bus_name(annotation.get(), endpoint.owner.c_str());
+  xdg_dbus_annotation_v1_set_object_path(annotation.get(),
+                                         endpoint.object_path.c_str());
+  return annotation;
+}
+}  // namespace ui
