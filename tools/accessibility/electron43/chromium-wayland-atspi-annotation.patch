+
+namespace ui {
+class XdgDBusAnnotationManager
+    : public wl::GlobalObjectRegistrar<XdgDBusAnnotationManager> {
+ public:
+  static constexpr const char kInterfaceName[] =
+      "xdg_dbus_annotation_manager_v1";
+  static void Instantiate(WaylandConnection* connection,
+                          wl_registry* registry,
+                          uint32_t name,
+                          const std::string& interface,
+                          uint32_t version);
+  explicit XdgDBusAnnotationManager(xdg_dbus_annotation_manager_v1* manager);
+  ~XdgDBusAnnotationManager();
+  wl::Object<xdg_dbus_annotation_v1> Create(
+      wl_surface* surface,
+      const PlatformWindow::AccessibilityEndpoint& endpoint);
+
+ private:
+  wl::Object<xdg_dbus_annotation_manager_v1> manager_;
+};
+}  // namespace ui
+#endif
